# -----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL (REQUIRED)
DATABASE_URL="postgresql://your-user:your-password@your-host.neon.tech/code-afterlife?sslmode=require"

# -----------------------------------------------------------------------------
# AUTH.JS v5 — GitHub OAuth (ALL REQUIRED)
AUTH_SECRET="your-random-32-char-secret-here"
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# NEXT AUTH URL (REQUIRED)
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# CRON SECRET (REQUIRED)
CRON_SECRET="your-random-cron-secret-here"

# -----------------------------------------------------------------------------
# GITHUB TOKEN (STRONGLY RECOMMENDED - functionally required for cron jobs)
GITHUB_TOKEN="ghp_your-personal-access-token-here"

# -----------------------------------------------------------------------------
# CLOUDINARY — Image Uploads (REQUIRED for screenshot uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# -----------------------------------------------------------------------------
# GROQ AI — AI Pulse Summaries & Project Chat (OPTIONAL but RECOMMENDED)
GROQ_API_KEY="gsk_your-groq-api-key-here"

# -----------------------------------------------------------------------------
# RESEND — Contact Form Emails (OPTIONAL)
RESEND_API_KEY="re_your-resend-api-key-here"
CONTACT_EMAIL="you@example.com"

# -----------------------------------------------------------------------------
# PUBLIC APP URL (OPTIONAL but recommended for SEO / absolute URL generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"