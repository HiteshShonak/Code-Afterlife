
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://your-user:your-password@your-host.neon.tech/code-afterlife?sslmode=require"

# -----------------------------------------------------------------------------
# AUTH.JS v5 — GitHub OAuth
AUTH_SECRET="your-random-32-char-secret-here"
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# NEXT AUTH URL
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# CRON SECRET — protects the /api/health/recalculate endpoint
CRON_SECRET="your-random-cron-secret-here"

# -----------------------------------------------------------------------------
# CLOUDINARY 
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# -----------------------------------------------------------------------------
# GITHUB WEBHOOK SECRET 
GITHUB_WEBHOOK_SECRET=""

# =============================================================================
# AFTER FILLING IN VALUES, RUN:
#   npm run db:push     — Push schema to Neon
#   npm run db:seed     — Seed demo projects and lineage chain
#   npm run dev         — Start dev server
# =============================================================================

# AI Integration
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
