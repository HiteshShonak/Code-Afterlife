generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// auth models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // custom fields
  githubId Int?    @unique
  username String? @unique

  // auth relations
  accounts Account[]
  sessions Session[]

  // project relations
  createdProjects     Project[] @relation("CreatedProjects")
  resurrectedProjects Project[] @relation("ResurrectedProjects")

  // social relations
  likes            ProjectLike[]
  comments         ProjectComment[]
  votes            ProjectVote[]
  followedProjects ProjectFollow[]
  followers        UserFollow[]     @relation("Followers")
  following        UserFollow[]     @relation("Following")
  timeCapsules     TimeCapsule[]
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// domain models

enum ProjectState {
  BORN
  ACTIVE
  STALLED
  SHIPPED
  DEAD
}

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("CreatedProjects", fields: [userId], references: [id])

  // github linkage
  githubRepoUrl String
  githubRepoId  Int?

  // deployed app
  deployedUrl String?

  // slug
  slug String @unique

  // project metadata
  title       String
  description String?  @db.Text
  summary     String?  @db.Text // summary
  stack       String[]
  screenshots String[]

  // lifecycle state
  state            ProjectState @default(BORN)
  health           Float        @default(50)
  lastHealthUpdate DateTime?

  // lineage
  parentProjectId   String?
  parentProject     Project?  @relation("ProjectLineage", fields: [parentProjectId], references: [id])
  children          Project[] @relation("ProjectLineage")
  resurrecterUserId String?
  resurrecter       User?     @relation("ResurrectedProjects", fields: [resurrecterUserId], references: [id])
  resurrectionDate  DateTime?
  lineageDepth      Int       @default(0)

  // messages
  testament    String? @db.Text
  deathReason  String? @db.Text
  timeCapsules TimeCapsule[]

  // social counts
  likeCount    Int @default(0)
  commentCount Int @default(0)
  voteCount    Int @default(0)
  viewCount    Int @default(0)

  // trending score
  trendingScore Float @default(0)

  // timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastActivityAt   DateTime?
  lastPulseCheckAt DateTime?

  // relations
  timelineEntries  TimelineEntry[]
  githubActivities GitHubActivity[]
  milestones       Milestone[]
  likes            ProjectLike[]
  comments         ProjectComment[]
  votes            ProjectVote[]
  followers        ProjectFollow[]
  views            ProjectView[]

  // indices
  @@index([userId])
  @@index([state])
  @@index([parentProjectId])
  @@index([trendingScore])
  @@index([health])
}

// time capsule

enum CapsuleType {
  MESSAGE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model TimeCapsule {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  type      CapsuleType @default(MESSAGE)
  title     String
  content   String?     @db.Text
  mediaUrl  String?
  
  createdAt DateTime @default(now())
  
  @@index([projectId])
}

// social models

model ProjectLike {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}

enum VoteType {
  WILL_SHIP
  WILL_DIE
}

model ProjectVote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vote      VoteType
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
}

// project follow
model ProjectFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// user follow
model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// timeline models

enum TimelineEntryType {
  MILESTONE
  DEATH
  RESURRECTION
  UPDATE
  SYSTEM_DECAY
  AI_BUILD_LOG
}

model TimelineEntry {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        TimelineEntryType
  title       String
  description String?           @db.Text
  image       String?
  data        Json?

  createdAt DateTime @default(now())

  @@index([projectId])
}

enum GitHubActivityType {
  PUSH
  PULL_REQUEST
  CREATE
  RELEASE
}

model GitHubActivity {
  id        String             @id @default(cuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      GitHubActivityType
  count     Int?
  data      Json?

  recordedAt DateTime @default(now())

  @@index([projectId])
}

enum MilestoneType {
  FIRST_USER
  FIRST_DEPLOYMENT
  SHIPPED
  FIRST_PR
  PIVOTED
  RESURRECTED
  DEATH
  ALMOST_QUIT
  AI_BUILD_LOG
}

model Milestone {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      MilestoneType

  createdAt DateTime @default(now())

  @@index([projectId])
}

// unique views
model ProjectView {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([projectId, ipAddress])
}

// notifications

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

